// POST /webhook
const express = require('express')
const fetch = require('node-fetch')
const app = express()
app.use(express.json())

app.post('/webhook', async (req, res) => {
  try {
    const payload = req.body
    // validate payload or token here

    const prompt = `TradingView alert for ${payload.symbol}: ${payload.side} at ${payload.price} on ${payload.time}`

    // Send to Anthropic Claude (pseudo-code)
    const response = await fetch('https://api.anthropic.com/v1/claude', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${process.env.CLAUDE_API_KEY}`
      },
      body: JSON.stringify({
        prompt,
        // other model parameters
      })
    })
    const claudeResult = await response.json()

    // Decide what to do with claudeResult: log, notify, or execute trade via broker API

    res.status(200).send('ok')
  } catch (err) {
    console.error(err)
    res.status(500).send('error')
  }
})

app.listen(process.env.PORT || 3000)

Prompt design tips
------------------
- Ask Claude to return structured JSON with clearly defined keys (e.g., action, confidence, reason).
- Enforce tight instructions: "Return only valid JSON with keys 'action' and 'confidence' — do not include extra text." Use system-level instructions if supported.
- Sanitize Claude output before acting on it.

