# Claude API key — when unset the server runs in mock-analysis mode.
ANTHROPIC_API_KEY=

# Model used for signal analysis (default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Shared secret required on incoming webhooks (payload "secret" field or
# X-Webhook-Secret header). Strongly recommended in production.
WEBHOOK_SECRET=

# Server port (default 3000)
PORT=3000

# Where signals are persisted (default ./data/signals.json)
DATA_FILE=

# Where the paper portfolio is persisted (default: portfolio.json next to DATA_FILE)
PORTFOLIO_FILE=

# --- Paper trading simulator ---
# Kill switch: set to false to evaluate signals without executing simulated trades
PAPER_ENABLED=true
# Virtual starting cash (default 100000)
PAPER_STARTING_CASH=100000
# Minimum Claude confidence required to execute a trade (default 0.6)
PAPER_MIN_CONFIDENCE=0.6
# Fraction of equity spent per buy (default 0.10)
PAPER_POSITION_PCT=0.10
# Maximum fraction of equity in a single symbol (default 0.25)
PAPER_MAX_POSITION_PCT=0.25
# Display currency (default "R" — South African rand)
PAPER_CURRENCY=R

# --- Interactive Brokers PAPER mirroring (optional; see DEPLOYMENT.md) ---
# Set BROKER=ibkr to mirror executed simulator trades to an IBKR paper account.
# PAPER ONLY: the adapter refuses live ports (7496/4001) and non-paper accounts.
BROKER=
IBKR_HOST=127.0.0.1
# 4002 = IB Gateway paper, 7497 = TWS paper (live ports are rejected)
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_EXCHANGE=SMART
IBKR_CURRENCY=USD
