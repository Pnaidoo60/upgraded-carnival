# Claude API key — when unset the server runs in mock-analysis mode.
ANTHROPIC_API_KEY=

# Model used for signal analysis (default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Shared secret required on incoming webhooks (payload "secret" field or
# X-Webhook-Secret header). Strongly recommended in production.
WEBHOOK_SECRET=

# Server port (default 3000)
PORT=3000

# Where signals are persisted (default ./data/signals.json)
DATA_FILE=
