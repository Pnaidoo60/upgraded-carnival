# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Your Anthropic API key. Get one at https://console.anthropic.com/
# If this is left blank, the server still runs and records incoming
# TradingView alerts — it just skips the Claude analysis step.
ANTHROPIC_API_KEY=

# Shared secret that must appear as the `secret` field in every TradingView
# alert payload. Protects your webhook from spoofed requests. Pick any random
# string and use the same value in your TradingView alert message.
# Leave blank to disable the check (fine for local testing, not for production).
WEBHOOK_SECRET=

# Port the server listens on.
PORT=3000

# Which Claude model to use. Opus 4.8 is the most capable; use
# claude-sonnet-5 for cheaper/faster analysis if you prefer.
CLAUDE_MODEL=claude-opus-4-8

# --- Paper trading (simulated, no broker) ---
# Turn the paper-trading engine on/off.
PAPER_TRADING=on
# Virtual starting cash for the portfolio.
PAPER_STARTING_CASH=100000
# Notional dollars per simulated trade (qty = notional / price).
PAPER_TRADE_NOTIONAL=10000
# Only act on a Claude recommendation at or above this confidence (0-1).
# "close" actions always execute. When no API key is set, trades follow the
# alert's `side` field directly and this threshold is ignored.
PAPER_MIN_CONFIDENCE=0.6
